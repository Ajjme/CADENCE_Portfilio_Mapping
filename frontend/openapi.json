{
  "openapi": "3.1.0",
  "info": {
    "title": "CADENCE API",
    "description": "Runs CADENCE roof Alternative Analyses and serves their results to the frontend.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Settings",
        "description": "Default run settings and the allowed values, for the settings form.",
        "operationId": "settings_api_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsChoices"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/example": {
      "get": {
        "summary": "Example Workbook",
        "description": "Download the example asset workbook, to use as a template.",
        "operationId": "example_workbook_api_portfolio_example_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/portfolio/default": {
      "get": {
        "summary": "Default Portfolio",
        "description": "The example workbook's assets, shown before anyone uploads their own.",
        "operationId": "default_portfolio_api_portfolio_default_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Portfolio"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio": {
      "post": {
        "summary": "Upload Portfolio",
        "description": "Upload and check an asset workbook. Use the returned workbook_id to run it.",
        "operationId": "upload_portfolio_api_portfolio_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_portfolio_api_portfolio_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Portfolio"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Run Analysis",
        "description": "Run the Alternative Analysis. This waits until the run finishes, which can take a few minutes.",
        "operationId": "run_analysis_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Run",
        "operationId": "run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/summary": {
      "get": {
        "summary": "Run Summary",
        "description": "Final NPV and the other results, by asset and replacement option, plus portfolio totals.",
        "operationId": "run_summary_api_runs__run_id__summary_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/series": {
      "get": {
        "summary": "Run Series",
        "description": "One yearly result for each replacement option, for the time series chart.",
        "operationId": "run_series_api_runs__run_id__series_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "asset_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One asset. Leave out for the whole portfolio.",
              "title": "Asset Id"
            },
            "description": "One asset. Leave out for the whole portfolio."
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "A key from GET /api/settings metrics",
              "default": "net_present_value_usd",
              "title": "Metric"
            },
            "description": "A key from GET /api/settings metrics"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/cost-allocations": {
      "get": {
        "summary": "Run Cost Allocations",
        "description": "One year's costs for each replacement option, for the cost allocation chart.",
        "operationId": "run_cost_allocations_api_runs__run_id__cost_allocations_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Year"
            }
          },
          {
            "name": "asset_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One asset. Leave out for the whole portfolio.",
              "title": "Asset Id"
            },
            "description": "One asset. Leave out for the whole portfolio."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostAllocations"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/export": {
      "get": {
        "summary": "Export Run",
        "description": "Download the whole run as one Excel file.",
        "operationId": "export_run_api_runs__run_id__export_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/market-study": {
      "get": {
        "summary": "Saved Market Study",
        "description": "The Market Study already saved for these settings. 404 if it hasn't been run yet.",
        "operationId": "saved_market_study_api_runs__run_id__market_study_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "max_payback_years",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "The payback limit the study was run with. Leave out for none.",
              "title": "Max Payback Years"
            },
            "description": "The payback limit the study was run with. Leave out for none."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketStudy"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run Market Study",
        "description": "Run the experimental Market Study for the whole portfolio. Waits until it finishes.",
        "operationId": "run_market_study_api_runs__run_id__market_study_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketStudyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketStudy"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetScenario": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "scenario_material_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Material Id"
          },
          "through_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Through Year"
          },
          "cumulative_avoided_damage_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cumulative Avoided Damage Usd"
          },
          "cumulative_discounted_avoided_damage_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cumulative Discounted Avoided Damage Usd"
          },
          "cumulative_net_benefit_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cumulative Net Benefit Usd"
          },
          "net_present_value_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Present Value Usd"
          },
          "burnout_replacement_count": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Burnout Replacement Count"
          },
          "active_cost_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Cost Source"
          },
          "active_cost_fallback_applied": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Cost Fallback Applied"
          },
          "repair_cost_incomplete": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repair Cost Incomplete"
          },
          "climate_risk_total_incomplete": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Climate Risk Total Incomplete"
          },
          "event_cost_incomplete": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Cost Incomplete"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "scenario_id"
        ],
        "title": "AssetScenario",
        "description": "Final results for one asset and replacement option."
      },
      "Body_upload_portfolio_api_portfolio_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CADENCE asset workbook (.xlsx)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_portfolio_api_portfolio_post"
      },
      "CostAllocation": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "material_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material Usd"
          },
          "labor_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labor Usd"
          },
          "repair_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repair Usd"
          },
          "loss_of_use_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loss Of Use Usd"
          },
          "disposal_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposal Usd"
          },
          "carbon_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carbon Usd"
          },
          "total_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Usd"
          },
          "allocation_estimated": {
            "type": "boolean",
            "title": "Allocation Estimated",
            "description": "True when the material and labor split uses default shares"
          }
        },
        "type": "object",
        "required": [
          "scenario_id",
          "allocation_estimated"
        ],
        "title": "CostAllocation",
        "description": "One replacement option's costs in one year, split into parts. A part is null when it can't be split."
      },
      "CostAllocations": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id",
            "description": "Null for the whole portfolio"
          },
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Labels",
            "description": "Cost columns and their labels, in chart order"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/CostAllocation"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "asset_id",
          "year",
          "labels",
          "rows"
        ],
        "title": "CostAllocations"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "MarketStudy": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "description": "The Alternative Analysis run the study is based on"
          },
          "study_id": {
            "type": "string",
            "title": "Study Id"
          },
          "max_payback_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Payback Years"
          },
          "newly_calculated": {
            "type": "boolean",
            "title": "Newly Calculated",
            "description": "False when an earlier study with the same settings was reused"
          },
          "asset_count": {
            "type": "integer",
            "title": "Asset Count"
          },
          "last_verified_year": {
            "type": "integer",
            "title": "Last Verified Year",
            "description": "The run's last year. Later years hold prices and climate constant"
          },
          "evaluation_end_year": {
            "type": "integer",
            "title": "Evaluation End Year"
          },
          "real_discount_rate": {
            "type": "number",
            "title": "Real Discount Rate"
          },
          "enabled_cost_streams": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enabled Cost Streams"
          },
          "tile_uses_metal_proxy": {
            "type": "boolean",
            "title": "Tile Uses Metal Proxy"
          },
          "policy_id": {
            "type": "string",
            "title": "Policy Id"
          },
          "cost_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Cost Labels",
            "description": "Cost columns and their labels, in chart order"
          },
          "roof_share": {
            "items": {
              "$ref": "#/components/schemas/RoofShare"
            },
            "type": "array",
            "title": "Roof Share"
          },
          "costs": {
            "items": {
              "$ref": "#/components/schemas/MarketYear"
            },
            "type": "array",
            "title": "Costs"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "study_id",
          "newly_calculated",
          "asset_count",
          "last_verified_year",
          "evaluation_end_year",
          "real_discount_rate",
          "enabled_cost_streams",
          "tile_uses_metal_proxy",
          "policy_id",
          "cost_labels",
          "roof_share",
          "costs"
        ],
        "title": "MarketStudy",
        "description": "An experimental study of which roofs a homeowner would replace each year, and when."
      },
      "MarketStudyRequest": {
        "properties": {
          "max_payback_years": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Payback Years",
            "description": "Longest payback a homeowner accepts for a voluntary replacement. Leave out for no limit."
          }
        },
        "type": "object",
        "title": "MarketStudyRequest"
      },
      "MarketYear": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "repair_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repair Usd"
          },
          "loss_of_use_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loss Of Use Usd"
          },
          "material_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material Usd"
          },
          "labor_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Labor Usd"
          },
          "disposal_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposal Usd"
          },
          "carbon_usd": {
            "anyOf": [
              {
                "type": "number"
